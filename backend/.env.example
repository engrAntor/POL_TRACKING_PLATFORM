# Django Security
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=False
# Add your server IP/domain here
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# AI
GEMINI_API_KEY=your-gemini-api-key

# Database — use PostgreSQL in production
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pol_tracking
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=your-db-host
DB_PORT=5432

# CORS & Frontend — must match your production frontend URL exactly
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
# Used in email links (verification, password reset)
FRONTEND_URL=https://yourdomain.com

# Redis / Celery
# Docker internal: redis://redis:6379/0
# External Redis: redis://your-redis-host:6379/0
REDIS_URL=redis://redis:6379/0

# Email (Google SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Stripe Integration
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
